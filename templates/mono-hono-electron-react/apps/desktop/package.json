{
  "name": "@mono-hono-electron-react/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.mjs",
  "scripts": {
    "dev": "node ./scripts/dev/index.js",
    "dev:renderer": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build && tsdown",
    "preview": "pnpm build && electron .",
    "dist": "pnpm build && electron-builder"
  },
  "devDependencies": {
    "@mono-hono-electron-react/api": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.7",
    "hono": "catalog:",
    "oxc-transform-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "build": {
    "appId": "com.example.app",
    "productName": "mono-hono-electron-react",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/main",
      "dist/renderer"
    ]
  }
}
