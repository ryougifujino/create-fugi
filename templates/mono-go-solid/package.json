{
  "name": "mono-go-solid",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:web": "pnpm --filter @mono-go-solid/web dev",
    "dev:server": "pnpm --filter @mono-go-solid/server dev",
    "build": "pnpm -r build",
    "build:embed": "pnpm --filter @mono-go-solid/web build && pnpm --filter @mono-go-solid/server build:embed",
    "start": "pnpm --filter @mono-go-solid/server start",
    "preview": "pnpm --filter @mono-go-solid/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "stylelint": "stylelint \"apps/**/*.{css,scss}\"",
    "stylelint:fix": "pnpm stylelint --fix \"apps/**/*.{css,scss}\"",
    "fmt": "node scripts/gofmt.mjs && oxfmt",
    "fmt:check": "node scripts/gofmt.mjs --check && oxfmt --check",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "eslint-plugin-solid": "^0.19.0",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  },
  "lint-staged": {
    "*.go": "gofmt -w",
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "oxfmt"
    ],
    "*.{json,md,html,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
