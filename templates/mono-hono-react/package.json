{
  "name": "mono-hono-react",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "dev:web": "pnpm --filter @mono-hono-react/web dev",
    "dev:server": "pnpm --filter @mono-hono-react/server dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @mono-hono-react/server start",
    "preview": "pnpm --filter @mono-hono-react/web preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "stylelint": "stylelint \"apps/**/*.{css,scss}\"",
    "stylelint:fix": "pnpm stylelint --fix \"apps/**/*.{css,scss}\"",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "lefthook": "^2.1.9",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{css,scss}": [
      "stylelint --fix",
      "oxfmt"
    ],
    "*.{json,md,html,yml,yaml}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "vite": "catalog:"
    },
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
